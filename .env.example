# Browser-safe Supabase configuration for local development
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-side values; use local test credentials only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
# Optional: if omitted, the session-signing key is derived from the service key.
ADMIN_SESSION_SECRET=replace_with_a_random_value_of_32_or_more_characters

# Set only for plain-HTTP localhost development. Leave unset for HTTPS Preview and production.
ORCHEST_ALLOW_INSECURE_LOCAL_COOKIES=true

# Public deployment origin used for canonical URLs and the YouTube OAuth callback.
PUBLIC_SITE_URL=https://your-public-domain.example
VITE_PUBLIC_SITE_URL=https://your-public-domain.example

# Optional AI provider for the grounded admin assistant and existing AI features.
LOVABLE_API_KEY=replace_me
# Optional Google Analytics 4 Measurement ID. GA4 stays inactive until a visitor consents.
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional server-side YouTube OAuth integration (read-only scope).
YOUTUBE_CLIENT_ID=replace_me
YOUTUBE_CLIENT_SECRET=replace_me
# Override only when the Google OAuth console uses a different exact callback.
YOUTUBE_REDIRECT_URI=https://your-public-domain.example/api/admin/youtube/callback

# Optional Web Push for admin notifications; generate a VAPID key pair outside the app.
VAPID_PUBLIC_KEY=replace_me
VAPID_PRIVATE_KEY=replace_me
VAPID_SUBJECT=mailto:admin@your-public-domain.example
